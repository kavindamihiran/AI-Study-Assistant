AI_API_KEY=
AI_BASE_URL=
ACTIVE_MODEL_PROFILE_ID=study_ai_default
FRONTEND_URL=http://127.0.0.1:3200
DATA_DIR=
MAX_UPLOAD_MB=25
DATABASE_URL=

# Local defaults require no external vector service.
VECTOR_STORE_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
AI_EMBEDDING_MODEL_ID=

# Managed AI routes. Keep real values in backend/.env.local.
AI_DEFAULT_MODEL_ID=
AI_FAST_MODEL_ID=
AI_ADVANCED_MODEL_ID=
AI_BALANCED_MODEL_ID=
AI_LONG_CONTEXT_MODEL_ID=

# Optional external vector storage.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=study-assistant

MODEL_PROFILES_PATH=
LLM_REQUEST_TIMEOUT_SECONDS=90

# Authentication
AUTH_SESSION_DAYS=7
AUTH_COOKIE_NAME=studyos_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REGISTRATION_ENABLED=true
